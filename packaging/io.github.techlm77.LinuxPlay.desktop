[Desktop Entry]
Type=Application
Version=1.0
Name=LinuxPlay
GenericName=Remote Desktop
Comment=Connect to your computers, or share this one, with low latency
Exec=linuxplay %u
Icon=io.github.techlm77.LinuxPlay
Terminal=false
Categories=Network;RemoteAccess;
Keywords=remote;desktop;screen;stream;control;vnc;rdp;
StartupNotify=true
# On its own it opens the window; with an address or invite link, a stream.
StartupWMClass=io.github.techlm77.LinuxPlay
