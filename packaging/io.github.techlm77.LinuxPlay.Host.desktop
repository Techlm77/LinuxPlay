[Desktop Entry]
Type=Application
Version=1.0
Name=LinuxPlay Host
GenericName=Screen Sharing
Comment=Share this computer's screen so another can connect to it
Exec=linuxplay-host
Icon=io.github.techlm77.LinuxPlay
Terminal=false
Categories=Network;RemoteAccess;
Keywords=remote;desktop;share;screen;host;server;
StartupNotify=false
# The window's Share page does this too; this standalone host (with its tray
# icon) is for command-line and headless setups, so it stays out of the menu.
NoDisplay=true
